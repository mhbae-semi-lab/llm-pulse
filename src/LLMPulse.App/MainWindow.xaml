<ui:FluentWindow x:Class="LLMPulse.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:loc="clr-namespace:LLMPulse.App.Localization"
                 xmlns:vm="clr-namespace:LLMPulse.App.ViewModels"
                 xmlns:views="clr-namespace:LLMPulse.App.Views"
                 Icon="Assets/app.ico"
                 Title="LLM Pulse" Height="760" Width="1280" MinHeight="520" MinWidth="900"
                 FontFamily="{StaticResource AppFont}" FontSize="16"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><views:DashboardView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:LeaderboardViewModel}"><views:LeaderboardView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:MetricsViewModel}"><views:MetricsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><views:SettingsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:AboutViewModel}"><views:AboutView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:CategoryDetailViewModel}"><views:CategoryDetailView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:CompareViewModel}"><views:CompareView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:MatchingViewModel}"><views:MatchingView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:PlansViewModel}"><views:PlansView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ModelDetailViewModel}"><views:ModelDetailView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:HistoryViewModel}"><views:HistoryView /></DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="LLM Pulse" />

        <!-- 상단 바: 검색 · 언어 · 테마 · 새로고침 · 마지막 갱신 -->
        <Grid x:Name="TopBar" Grid.Row="1" Margin="12,4,12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="LLM Pulse" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" Margin="12,0,0,0" />

            <ui:TextBox x:Name="SearchBox" Grid.Column="1" MaxWidth="420" HorizontalAlignment="Left" Margin="12,0"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     PlaceholderText="{loc:Loc Search_Placeholder}"
                     AutomationProperties.Name="{loc:Loc Search_Placeholder}" />

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Padding="8,2" CornerRadius="4" Margin="0,0,12,0" VerticalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="Transparent" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding FreshnessWarning}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding Freshness}" />
                </Border>

                <ui:ToggleSwitch Margin="0,0,16,0" VerticalAlignment="Center"
                                 Content="{loc:Loc Leaderboard_MyPlanOnly}"
                                 IsChecked="{Binding State.PlanOnly, Mode=TwoWay}"
                                 Visibility="{Binding State.HasPlans, Converter={StaticResource BoolToVis}}"
                                 ToolTip="{loc:Loc Plan_OnlyTip}"
                                 AutomationProperties.Name="{loc:Loc Leaderboard_MyPlanOnly}" />

                <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}" MinWidth="110"
                          AutomationProperties.Name="{loc:Loc Action_Language}" />

                <Button Click="OnMoreMenu" Margin="8,0,0,0" Padding="10,6"
                        ToolTip="{loc:Loc Menu_More}" AutomationProperties.Name="{loc:Loc Menu_More}">
                    <TextBlock Text="&#xE712;" FontFamily="Segoe MDL2 Assets" FontSize="18" />
                </Button>

                <Button Command="{Binding Refresher.RefreshCommand}" Margin="8,0,0,0" Padding="14,6"
                        AutomationProperties.Name="{loc:Loc Action_Refresh}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="{loc:Loc Action_Refresh}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Grid x:Name="BodyGrid" Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 좌측 내비게이션 -->
            <ListBox Grid.Column="0" ItemsSource="{Binding NavItems}" SelectedItem="{Binding SelectedNav}"
                     Margin="12,0,0,0" BorderThickness="0" Background="Transparent"
                     AutomationProperties.Name="Navigation">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="12,10" />
                        <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                        <Setter Property="Margin" Value="0,0,0,2" />
                        <EventSetter Event="PreviewMouseLeftButtonUp" Handler="OnNavItemClick" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" Padding="{TemplateBinding Padding}" CornerRadius="6" Background="Transparent">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                            <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:NavItemViewModel}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                       Width="28" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <ContentControl x:Name="PageHost" Grid.Column="1" Content="{Binding CurrentPage}" IsTabStop="False" />
        </Grid>

        <!-- 푸터: 출처 표기 (Artificial Analysis attribution 의무) -->
        <TextBlock x:Name="FooterText" Grid.Row="3" Margin="24,6,24,10" FontSize="16"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}">
            <Run Text="{loc:Loc Footer_Data}" />
            <Hyperlink NavigateUri="https://artificialanalysis.ai/" RequestNavigate="OnNavigate">Artificial Analysis</Hyperlink>
            <Run Text=" · " />
            <Run Text="{loc:Loc Footer_Disclaimer}" />
        </TextBlock>

        <!-- 첫 실행 마법사 -->
        <Grid Grid.Row="0" Grid.RowSpan="4" DataContext="{Binding Wizard}"
              Visibility="{Binding IsOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="#B0000000" />
            <Border MaxWidth="640" Margin="32" Padding="28,24" CornerRadius="12"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource ApplicationBackgroundBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Wizard_Title}" FontSize="26" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding StepText}" Margin="0,2,0,16"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                    <!-- 1단계: API 키 -->
                    <StackPanel Visibility="{Binding IsStep0, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{loc:Loc Wizard_KeyTitle}" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="{loc:Loc Wizard_KeyBody}" TextWrapping="Wrap" Margin="0,6,0,12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <StackPanel Orientation="Horizontal">
                            <PasswordBox x:Name="WizardKeyBox" Width="340" AutomationProperties.Name="{loc:Loc Settings_ApiKey}" />
                            <Button Content="{loc:Loc Action_Save}" Click="OnWizardSaveKey" Margin="12,0,0,0" Padding="16,6" />
                        </StackPanel>
                        <TextBlock Text="{Binding KeyStatus}" Margin="0,8,0,0" />
                    </StackPanel>

                    <!-- 2단계: 구독 선택 -->
                    <StackPanel Visibility="{Binding IsStep1, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{loc:Loc Wizard_PlansTitle}" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="{loc:Loc Wizard_PlansBody}" TextWrapping="Wrap" Margin="0,6,0,12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Plans}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,0,0,6">
                                            <TextBlock>
                                                <Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" />
                                                <Run Text="  " /><Run Text="{Binding Detail, Mode=OneWay}"
                                                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </TextBlock>
                                        </CheckBox>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>

                    <!-- 3단계: 완료 -->
                    <StackPanel Visibility="{Binding IsStep2, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{loc:Loc Wizard_DoneTitle}" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="{loc:Loc Wizard_DoneBody}" Margin="0,8,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,2,0,12" />
                        <CheckBox Content="{loc:Loc Wizard_OnlyMine}" IsChecked="{Binding UsePlanOnly, Mode=TwoWay}" />
                        <TextBlock Text="{loc:Loc Wizard_DoneNote}" TextWrapping="Wrap" Margin="0,12,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                        <Button Content="{loc:Loc Wizard_Skip}" Command="{Binding SkipCommand}" Padding="16,6" />
                        <Button Content="{loc:Loc Wizard_Back}" Command="{Binding BackCommand}" Margin="8,0,0,0" Padding="16,6"
                                Visibility="{Binding CanBack, Converter={StaticResource BoolToVis}}" />
                        <Button Content="{loc:Loc Wizard_Next}" Command="{Binding NextCommand}" Margin="8,0,0,0" Padding="20,6"
                                Visibility="{Binding IsNotLast, Converter={StaticResource BoolToVis}}" />
                        <Button Content="{loc:Loc Wizard_Finish}" Command="{Binding NextCommand}" Margin="8,0,0,0" Padding="20,6"
                                Visibility="{Binding IsLast, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
