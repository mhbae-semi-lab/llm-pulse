<UserControl x:Class="LLMPulse.App.Views.PlansView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:LLMPulse.App.Localization"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,8,24,24" MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Text="{loc:Loc Plans_Title}" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="{loc:Loc Plans_Help}" TextWrapping="Wrap" Margin="0,4,0,16"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

            <!-- 프로필 -->
            <WrapPanel Margin="0,0,0,16">
                <TextBlock Text="{loc:Loc Plans_Profile}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" MinWidth="160"
                          AutomationProperties.Name="{loc:Loc Plans_Profile}" />
                <Button Content="{loc:Loc Plans_ProfileDelete}" Command="{Binding DeleteProfileCommand}" Margin="8,0,24,0" Padding="12,6" />
                <TextBox Text="{Binding NewProfileName, UpdateSourceTrigger=PropertyChanged}" Width="160"
                         AutomationProperties.Name="{loc:Loc Plans_ProfileName}" />
                <Button Content="{loc:Loc Plans_ProfileSave}" Command="{Binding SaveProfileCommand}" Margin="8,0,24,0" Padding="12,6" />
                <Button Content="{loc:Loc Plans_RunWizard}" Command="{Binding RunWizardCommand}" Padding="12,6" />
            </WrapPanel>

            <!-- 구독 vs API 비용 -->
            <Border Visibility="{Binding HasEconomics, Converter={StaticResource BoolToVis}}"
                    Padding="16,12" Margin="0,0,0,12" CornerRadius="8"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource SystemAccentColorPrimaryBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Plans_EconTitle}" FontWeight="SemiBold" FontSize="18" />
                    <TextBlock Text="{Binding Economics}" TextWrapping="Wrap" Margin="0,6,0,0" />
                    <TextBlock Text="{loc:Loc Plans_EconNote}" TextWrapping="Wrap" Margin="0,6,0,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <TextBlock Text="{loc:Loc Plans_EconUsage}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox Text="{Binding MonthlyTokensText, UpdateSourceTrigger=LostFocus}" Width="90"
                         AutomationProperties.Name="{loc:Loc Plans_EconUsage}" />
            </StackPanel>

            <ItemsControl ItemsSource="{Binding Cards}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="16,12" Margin="0,0,0,12" CornerRadius="8"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel>
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}">
                                    <TextBlock>
                                        <Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" FontSize="18" />
                                        <Run Text="  " /><Run Text="{Binding Detail, Mode=OneWay}"
                                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </TextBlock>
                                </CheckBox>
                                <TextBlock Text="{Binding Note}" TextWrapping="Wrap" Margin="28,0,0,0"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{Binding BreakEven}" TextWrapping="Wrap" Margin="28,4,0,0" />

                                <StackPanel Margin="28,12,0,0"
                                            Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}">
                                    <!-- 사용량 한도 메모 + 카운터 -->
                                    <TextBlock Text="{loc:Loc Plans_Limit}" FontWeight="SemiBold" />
                                    <WrapPanel Margin="0,6,0,0">
                                        <TextBlock Text="{loc:Loc Plans_LimitCap}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBox Text="{Binding CapText, UpdateSourceTrigger=LostFocus}" Width="80"
                                                 AutomationProperties.Name="{loc:Loc Plans_LimitCap}" />
                                        <TextBlock Text="/" VerticalAlignment="Center" Margin="8,0" />
                                        <ComboBox MinWidth="110"
                                                  ItemsSource="{Binding DataContext.PeriodOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  SelectedIndex="{Binding PeriodIndex}"
                                                  AutomationProperties.Name="{loc:Loc Plans_LimitPeriod}" />
                                        <ui:TextBox Text="{Binding LimitNote, UpdateSourceTrigger=LostFocus}" Width="300" Margin="16,0,0,0"
                                                 PlaceholderText="{loc:Loc Plans_LimitNote}"
                                                 AutomationProperties.Name="{loc:Loc Plans_LimitNote}" />
                                    </WrapPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Button Content="−1" Command="{Binding MinusCommand}" Padding="12,4" MinWidth="44" AutomationProperties.Name="{loc:Loc Plans_MinusOne}" />
                                        <Button Content="+1" Command="{Binding PlusCommand}" Padding="12,4" MinWidth="44" Margin="6,0,0,0" AutomationProperties.Name="{loc:Loc Plans_PlusOne}" />
                                        <TextBlock Text="{Binding UsageText}" VerticalAlignment="Center" Margin="14,0,0,0" />
                                        <Button Content="{loc:Loc Plans_UsageReset}" Command="{Binding ResetUsageCommand}"
                                                Padding="10,4" Margin="14,0,0,0" />
                                    </StackPanel>
                                    <ProgressBar Minimum="0" Maximum="1" Value="{Binding UsageRatio, Mode=OneWay}" Height="6" Margin="0,8,0,0"
                                                 Visibility="{Binding HasCap, Converter={StaticResource BoolToVis}}">
                                        <ProgressBar.Style>
                                            <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding NearLimit}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ProgressBar.Style>
                                    </ProgressBar>

                                    <!-- 모델별 접근 편집 -->
                                    <Expander Header="{loc:Loc Plans_Models}" IsExpanded="{Binding IsExpanded, Mode=TwoWay}" Margin="0,12,0,0">
                                        <StackPanel Margin="0,8,0,0">
                                            <TextBlock Text="{loc:Loc Plans_ModelsHelp}" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <StackPanel Orientation="Horizontal" Margin="0,8,0,8">
                                                <ui:TextBox Text="{Binding ModelFilter, UpdateSourceTrigger=PropertyChanged}" Width="240"
                                                         PlaceholderText="{loc:Loc Plans_ModelFilter}"
                                                         AutomationProperties.Name="{loc:Loc Plans_ModelFilter}" />
                                                <TextBlock Text="{Binding ModelSummary}" VerticalAlignment="Center" Margin="16,0,0,0"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                            <ListBox ItemsSource="{Binding Rows}" MaxHeight="340" BorderThickness="0" Background="Transparent"
                                                     VirtualizingPanel.IsVirtualizing="True">
                                                <ListBox.ItemContainerStyle>
                                                    <Style TargetType="ListBoxItem">
                                                        <Setter Property="Focusable" Value="False" />
                                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                        <Setter Property="Padding" Value="0,2" />
                                                    </Style>
                                                </ListBox.ItemContainerStyle>
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="140" />
                                                                <ColumnDefinition Width="140" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Grid.Column="1" Text="{Binding Vendor}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                            <ComboBox Grid.Column="2" Margin="0,0,8,0"
                                                                      ItemsSource="{Binding DataContext.AccessOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                      SelectedIndex="{Binding AccessIndex, Mode=TwoWay}"
                                                                      AutomationProperties.Name="{loc:Loc Plans_Access}" />
                                                            <Button Grid.Column="3" Content="{loc:Loc Plans_AccessReset}" Command="{Binding ResetCommand}"
                                                                    Padding="8,2"
                                                                    Visibility="{Binding IsOverridden, Converter={StaticResource BoolToVis}}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="{Binding Warning}" TextWrapping="Wrap"
                       Foreground="{DynamicResource SystemFillColorCautionBrush}" />
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="{loc:Loc Settings_OpenDataFolder}" Command="{Binding OpenDataFolderCommand}" Padding="14,6" />
                <TextBlock Text="{Binding PathText}" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
