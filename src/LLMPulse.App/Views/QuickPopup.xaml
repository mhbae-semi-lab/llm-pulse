<Window x:Class="LLMPulse.App.Views.QuickPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:LLMPulse.App.Localization"
        Title="LLM Pulse" Width="400" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        FontFamily="{StaticResource AppFont}" FontSize="16"
        ShowActivated="True" Deactivated="OnDeactivated">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    <Border MouseLeftButtonDown="OnDrag" BorderBrush="{DynamicResource SystemAccentColorPrimaryBrush}" BorderThickness="1" Padding="20,16">
        <StackPanel>
            <Grid Visibility="{Binding HasPick, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="{Binding PickTitle}" FontWeight="SemiBold"
                               Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="{Binding PickName}" FontSize="24" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="300" />
                        <TextBlock Text="⚠" FontSize="20" Margin="10,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                   Visibility="{Binding PickLimited, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                    <TextBlock Text="{Binding PickMeta}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ItemsControl ItemsSource="{Binding Alternatives}" Margin="0,10,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Margin="0,2,0,0" TextTrimming="CharacterEllipsis">
                                    <Run Text="{Binding Name, Mode=OneWay}" />
                                    <Run Text="  " /><Run Text="{Binding Meta, Mode=OneWay}" FontSize="14"
                                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
            <StackPanel Margin="0,12,0,0" Visibility="{Binding HasLimitBars, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{loc:Loc Widget_Usage}" FontWeight="SemiBold" />
                <ItemsControl ItemsSource="{Binding LimitBars}" Margin="0,4,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock>
                                        <Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" />
                                        <Run Text="  " /><Run Text="{Binding Text, Mode=OneWay}" FontSize="14"
                                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </TextBlock>
                                    <ProgressBar Minimum="0" Maximum="1" Value="{Binding Ratio, Mode=OneWay}" Height="6" Margin="0,4,12,0">
                                        <ProgressBar.Style>
                                            <Style TargetType="ProgressBar">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Level}" Value="warn">
                                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Level}" Value="full">
                                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ProgressBar.Style>
                                    </ProgressBar>
                                </StackPanel>
                                <Button Grid.Column="1" Content="+1" Command="{Binding AddCommand}" Padding="10,2" MinWidth="40"
                                        ToolTip="{loc:Loc Widget_Plus}" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
            <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,12,0,0"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button x:Name="CloseButton" Content="{loc:Loc Widget_Close}" Click="OnClose" Padding="14,6" Margin="0,0,8,0" Visibility="Collapsed" />
                <Button Content="{loc:Loc Tray_Refresh}" Click="OnRefresh" Padding="14,6" />
                <Button Content="{loc:Loc Tray_Open}" Click="OnOpen" Padding="14,6" Margin="8,0,0,0" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>