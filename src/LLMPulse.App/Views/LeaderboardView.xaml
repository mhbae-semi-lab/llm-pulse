<UserControl x:Class="LLMPulse.App.Views.LeaderboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:LLMPulse.App.Localization"
             xmlns:app="clr-namespace:LLMPulse.App">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <app:InverseBoolToVisibilityConverter x:Key="InvBoolToVis" />
    </UserControl.Resources>
    <Grid Margin="24,8,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{loc:Loc Leaderboard_Title}" FontSize="28" FontWeight="SemiBold" />

        <WrapPanel Grid.Row="1" Margin="0,12,0,12"
                    Visibility="{Binding HasData, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{loc:Loc Leaderboard_Vendor}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox ItemsSource="{Binding Vendors}" SelectedItem="{Binding SelectedVendor}" MinWidth="200"
                      AutomationProperties.Name="{loc:Loc Leaderboard_Vendor}" />
            <TextBlock Text="{Binding CountText}" VerticalAlignment="Center" Margin="24,0,0,0"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <TextBlock Text="{loc:Loc Leaderboard_RowHint}" VerticalAlignment="Center" Margin="24,0,0,0"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <TextBlock Text="{loc:Loc Leaderboard_HeatHint}" VerticalAlignment="Center" Margin="24,0,0,0"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <ComboBox ItemsSource="{Binding PriceOptions}" SelectedItem="{Binding MaxPrice}" MinWidth="130" Margin="16,0,0,0"
                      AutomationProperties.Name="{loc:Loc Col_Price}" />
            <ComboBox ItemsSource="{Binding ContextOptions}" SelectedItem="{Binding MinContext}" MinWidth="150" Margin="8,0,0,0"
                      AutomationProperties.Name="{loc:Loc Leaderboard_AnyContext}" />
            <ToggleButton Content="{loc:Loc Leaderboard_RecentOnly}" IsChecked="{Binding RecentOnly, Mode=TwoWay}"
                          Margin="16,0,0,0" Padding="14,6" />
            <ToggleButton Content="{loc:Loc Leaderboard_FavoritesOnly}" IsChecked="{Binding FavoritesOnly, Mode=TwoWay}"
                          Margin="8,0,0,0" Padding="14,6" />
            <ToggleButton Content="{loc:Loc Leaderboard_MyPlanOnly}" IsChecked="{Binding State.PlanOnly, Mode=TwoWay}"
                          Visibility="{Binding State.HasPlans, Converter={StaticResource BoolToVis}}"
                          Margin="8,0,0,0" Padding="14,6" />
            <Button Content="{loc:Loc Leaderboard_Columns}" Click="OnColumns" Margin="12,0,0,0" Padding="14,6" />
            <Button Content="{loc:Loc Action_ExportCsv}" Click="OnExportCsv" Margin="12,0,0,0" Padding="14,6" />
            <Button Content="{Binding CompareText}" Command="{Binding CompareCommand}" Margin="24,0,0,0" Padding="14,6" />
        </WrapPanel>

        <TextBlock Grid.Row="2" Text="{loc:Loc Dashboard_EmptyBody}" TextWrapping="Wrap" Margin="0,16,0,0"
                   Visibility="{Binding HasData, Converter={StaticResource InvBoolToVis}}"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

        <DataGrid x:Name="Grid" Grid.Row="2" ItemsSource="{Binding Rows}"
                  Visibility="{Binding HasData, Converter={StaticResource BoolToVis}}"
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                  CanUserSortColumns="True" GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column" SelectionMode="Extended" SelectionUnit="FullRow"
                  EnableRowVirtualization="True" EnableColumnVirtualization="False"
                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                  RowHeaderWidth="0" FontSize="16"
                  SelectionChanged="OnSelectionChanged" MouseDoubleClick="OnRowDoubleClick" />
    </Grid>
</UserControl>
