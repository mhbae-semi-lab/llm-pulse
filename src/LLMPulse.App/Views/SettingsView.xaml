<UserControl x:Class="LLMPulse.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:LLMPulse.App.Localization">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,8,24,24" MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Text="{loc:Loc Settings_Title}" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,16" />

            <!-- 가성비 허용치 -->
            <TextBlock Text="{loc:Loc Settings_Tolerance}" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="{loc:Loc Settings_ToleranceHelp}" TextWrapping="Wrap" Margin="0,4,0,8"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                <Slider Minimum="50" Maximum="100" Width="320" TickFrequency="5" IsSnapToTickEnabled="True"
                        Value="{Binding TolerancePercent, Mode=TwoWay}"
                        AutomationProperties.Name="{loc:Loc Settings_Tolerance}" />
                <TextBlock Text="{Binding ToleranceText}" Margin="16,0,0,0" VerticalAlignment="Center" MinWidth="80" />
            </StackPanel>

            <!-- API 키 -->
            <TextBlock Text="{loc:Loc Settings_ApiKey}" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="{loc:Loc Settings_ApiKeyHelp}" TextWrapping="Wrap" Margin="0,4,0,8"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <StackPanel Orientation="Horizontal">
                <PasswordBox x:Name="KeyBox" Width="360" AutomationProperties.Name="{loc:Loc Settings_ApiKey}" />
                <Button Content="{loc:Loc Action_Save}" Click="OnSaveKey" Margin="12,0,0,0" Padding="16,6" />
            </StackPanel>
            <TextBlock Text="{Binding KeyStatus}" Margin="0,6,0,24" />

            <!-- 갱신 -->
            <TextBlock Text="{loc:Loc Settings_Refresh}" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="{loc:Loc Settings_RefreshHelp}" TextWrapping="Wrap" Margin="0,4,0,8"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <Button Content="{loc:Loc Action_Refresh}" Command="{Binding Refresher.RefreshCommand}"
                    HorizontalAlignment="Left" Padding="16,6" />
            <TextBlock Text="{Binding Refresher.StatusText}" Margin="0,6,0,24" TextWrapping="Wrap" />

            <!-- 자동 갱신 / 트레이 / 알림 -->
            <TextBlock Text="{loc:Loc Settings_Schedule}" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="{loc:Loc Settings_ScheduleHelp}" TextWrapping="Wrap" Margin="0,4,0,8"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{loc:Loc Settings_RefreshTime}" VerticalAlignment="Center" Margin="0,0,12,0" />
                <TextBox Text="{Binding RefreshTimeText, UpdateSourceTrigger=LostFocus}" Width="90"
                         AutomationProperties.Name="{loc:Loc Settings_RefreshTime}" />
                <Button Content="{loc:Loc Settings_Register}" Command="{Binding RegisterCommand}" Margin="16,0,0,0" Padding="16,6" />
                <Button Content="{loc:Loc Settings_Unregister}" Command="{Binding UnregisterCommand}" Margin="8,0,0,0" Padding="16,6" />
            </StackPanel>
            <TextBlock Text="{Binding ScheduleStatus}" Margin="0,6,0,12" TextWrapping="Wrap" />
            <CheckBox Content="{loc:Loc Settings_StartWithWindows}" IsChecked="{Binding StartWithWindows, Mode=TwoWay}" />
            <CheckBox Content="{loc:Loc Settings_TrayResident}" IsChecked="{Binding TrayResident, Mode=TwoWay}" Margin="0,4,0,0" />
            <CheckBox Content="{loc:Loc Settings_AutoClaude}" IsChecked="{Binding AutoClaudeUsage, Mode=TwoWay}"
                      IsEnabled="{Binding ClaudeHistoryFound}" Margin="0,4,0,0" />
            <TextBlock Text="{loc:Loc Settings_AutoClaudeHelp}" TextWrapping="Wrap" Margin="28,2,0,0"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <CheckBox Content="{loc:Loc Settings_AutoUpdate}" IsChecked="{Binding AutoUpdate, Mode=TwoWay}" Margin="0,4,0,0" />
            <CheckBox Content="{loc:Loc Settings_Notify}" IsChecked="{Binding NotifyEnabled, Mode=TwoWay}" Margin="0,4,0,0" />
            <StackPanel Margin="28,0,0,24" IsEnabled="{Binding NotifyEnabled}">
                <CheckBox Content="{loc:Loc Settings_NotifyTop}" IsChecked="{Binding NotifyTop, Mode=TwoWay}" Margin="0,4,0,0" />
                <CheckBox Content="{loc:Loc Settings_NotifyPrice}" IsChecked="{Binding NotifyPrice, Mode=TwoWay}" Margin="0,4,0,0" />
                <CheckBox Content="{loc:Loc Settings_NotifyLimit}" IsChecked="{Binding NotifyLimit, Mode=TwoWay}" Margin="0,4,0,0" />
            </StackPanel>

            <!-- 백업 -->
            <TextBlock Text="{loc:Loc Backup_Title}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,4" />
            <TextBlock Text="{loc:Loc Backup_Help}" TextWrapping="Wrap" Margin="0,0,0,8"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <Button Content="{loc:Loc Backup_Export}" Command="{Binding ExportBackupCommand}" Padding="12,6" />
                <Button Content="{loc:Loc Backup_Import}" Command="{Binding ImportBackupCommand}" Padding="12,6" Margin="8,0,0,0" />
            </StackPanel>
            <TextBlock Text="{Binding BackupStatus}" TextWrapping="Wrap" Margin="0,0,0,24" />

            <!-- 소스 상태 -->
            <TextBlock Text="{loc:Loc Settings_Sources}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8" />
            <CheckBox Content="{loc:Loc Settings_IncludeStale}" IsChecked="{Binding IncludeStaleSources, Mode=TwoWay}" Margin="0,0,0,2" />
            <TextBlock Text="{loc:Loc Settings_IncludeStaleHelp}" TextWrapping="Wrap" Margin="28,0,0,8"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <ItemsControl ItemsSource="{Binding Sources}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="12" Margin="0,0,0,8" CornerRadius="6"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="{Binding Source}" FontWeight="SemiBold" />
                                <TextBlock>
                                    <Run Text="{loc:Loc Settings_LastSuccess}" /><Run Text=": " /><Run Text="{Binding LastSuccess, Mode=OneWay}" />
                                    <Run Text=" · " /><Run Text="{Binding Status, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Text="{Binding DataAsOf}" />
                                <TextBlock Text="{Binding StaleWarning}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,4,0,2"
                                           Foreground="#D9822B"
                                           Visibility="{Binding IsStale, Converter={StaticResource BoolToVis}}" />
                                <TextBlock Text="{Binding Hint}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,4,0,2"
                                           Foreground="#E5484D"
                                           Visibility="{Binding HasHint, Converter={StaticResource BoolToVis}}" />
                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
