<UserControl x:Class="LLMPulse.App.Views.ModelDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:LLMPulse.App.Localization"
             xmlns:app="clr-namespace:LLMPulse.App"
             xmlns:controls="clr-namespace:LLMPulse.App.Controls">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <app:InverseBoolToVisibilityConverter x:Key="InvBoolToVis" />
        <Style x:Key="Dim" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,8,24,24" MaxWidth="1000" HorizontalAlignment="Left">
            <DockPanel Margin="0,0,0,12">
                <Button DockPanel.Dock="Left" Content="{loc:Loc Action_Back}" Command="{Binding BackCommand}" Padding="12,6" Margin="0,0,16,0" />
                <Button DockPanel.Dock="Right" Content="{loc:Loc Model_OpenLeaderboard}" Command="{Binding OpenLeaderboardCommand}" Padding="12,6" />
                <TextBlock />
            </DockPanel>

            <TextBlock Text="{loc:Loc Model_NotFound}" Style="{StaticResource Dim}" FontSize="16"
                       Visibility="{Binding Found, Converter={StaticResource InvBoolToVis}}" />

            <StackPanel Visibility="{Binding Found, Converter={StaticResource BoolToVis}}">
                <!-- 제목 -->
                <DockPanel>
                    <ToggleButton DockPanel.Dock="Right" IsChecked="{Binding IsFavorite, Mode=OneWay}"
                                  Command="{Binding ToggleFavoriteCommand}" ToolTip="{loc:Loc Leaderboard_FavToggle}"
                                  Padding="12,8" VerticalAlignment="Top">
                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="22">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="&#xE734;" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                            <Setter Property="Text" Value="&#xE735;" />
                                            <Setter Property="Foreground" Value="#F2B01E" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </ToggleButton>
                    <StackPanel>
                        <TextBlock Text="{Binding Name}" FontSize="32" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Dim}" FontSize="17" />
                    </StackPanel>
                </DockPanel>

                <!-- 핵심 수치 -->
                <ItemsControl ItemsSource="{Binding Facts}" Margin="0,16,0,8">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,12,12" Padding="18,12" MinWidth="150" CornerRadius="8"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="{Binding Label}" Style="{StaticResource Dim}" />
                                    <TextBlock Text="{Binding Value}" FontSize="24" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 내 구독 접근 -->
                <TextBlock Text="{loc:Loc Model_Plans}" FontSize="20" FontWeight="SemiBold" Margin="0,8,0,6" />
                <TextBlock Text="{loc:Loc Model_NoPlans}" Style="{StaticResource Dim}" FontSize="16" TextWrapping="Wrap"
                           Visibility="{Binding HasPlanRows, Converter={StaticResource InvBoolToVis}}" />
                <ItemsControl ItemsSource="{Binding PlanRows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                                <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="18" Width="28" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Level}" Value="limited">
                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Level}" Value="none">
                                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding Text}" FontSize="18" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 분야별 점수 -->
                <TextBlock Text="{loc:Loc Model_Scores}" FontSize="20" FontWeight="SemiBold" Margin="0,20,0,8" />
                <ItemsControl ItemsSource="{Binding Scores}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,6" Padding="16,10" CornerRadius="8" Cursor="Hand"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick" Command="{Binding OpenCommand}" />
                                </Border.InputBindings>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="110" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Title}" FontSize="18" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <ProgressBar Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding Score, Mode=OneWay}" Height="10"
                                                 VerticalAlignment="Center" Margin="0,0,16,0"
                                                 Visibility="{Binding HasScore, Converter={StaticResource BoolToVis}}" />
                                    <TextBlock Grid.Column="2" Text="{Binding ScoreText}" FontSize="18" FontWeight="SemiBold"
                                               HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0" />
                                    <TextBlock Grid.Column="3" Text="{Binding RankText}" Style="{StaticResource Dim}" VerticalAlignment="Center" />
                                    <controls:Sparkline Grid.Column="4" Width="90" Height="26" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                        Values="{Binding Trend}"
                                                        Visibility="{Binding HasTrend, Converter={StaticResource BoolToVis}}"
                                                        Stroke="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 가격 추이 -->
                <StackPanel Visibility="{Binding HasPriceHistory, Converter={StaticResource BoolToVis}}" Margin="0,20,0,0">
                    <TextBlock Text="{loc:Loc Model_PriceHistory}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal">
                        <controls:Sparkline Width="240" Height="44" Values="{Binding PriceHistory}"
                                            Stroke="{DynamicResource SystemAccentColorPrimaryBrush}" />
                        <TextBlock Text="{Binding PriceHistoryText}" Style="{StaticResource Dim}" VerticalAlignment="Center" Margin="16,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>