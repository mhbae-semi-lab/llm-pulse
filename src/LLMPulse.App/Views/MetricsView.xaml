<UserControl x:Class="LLMPulse.App.Views.MetricsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:LLMPulse.App.Localization">
    <Grid Margin="24,8,24,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{loc:Loc Metrics_Title}" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,12" />

        <ListBox x:Name="List" Grid.Row="1" ItemsSource="{Binding Cards}" SelectedItem="{Binding Selected}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.CanContentScroll="False"
                 HorizontalContentAlignment="Stretch" BorderThickness="0" Background="Transparent">
            <ListBox.Template>
                <ControlTemplate TargetType="ListBox">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                        <StackPanel>
                            <!-- 점수 산정 방식 -->
                            <Border Padding="20" Margin="0,0,0,16" CornerRadius="8"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="{loc:Loc Scoring_Title}" FontSize="22" FontWeight="SemiBold" />
                                    <TextBlock Text="{loc:Loc Scoring_Percentile}" TextWrapping="Wrap" Margin="0,10,0,0" />
                                    <TextBlock Text="{loc:Loc Scoring_Index}" TextWrapping="Wrap" Margin="0,8,0,0" />
                                    <TextBlock Text="{loc:Loc Scoring_Missing}" TextWrapping="Wrap" Margin="0,8,0,0" />
                                    <TextBlock Text="{loc:Loc Scoring_Best}" TextWrapping="Wrap" Margin="0,8,0,0" />
                                    <TextBlock Text="{loc:Loc Scoring_Value}" TextWrapping="Wrap" Margin="0,8,0,0" />
                                    <TextBlock DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               Text="{Binding ScoringExample}" TextWrapping="Wrap" Margin="0,8,0,0"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{loc:Loc Scoring_Limits}" TextWrapping="Wrap" Margin="0,8,0,0"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Border>
                            <ItemsPresenter />
                        </StackPanel>
                    </ScrollViewer>
                </ControlTemplate>
            </ListBox.Template>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,0,0,12" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Card" Padding="20" CornerRadius="8" BorderThickness="2"
                                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Card" Property="BorderBrush"
                                                Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <TextBlock Text="{Binding Name}" FontSize="22" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,4,0,10" />

                        <TextBlock FontWeight="SemiBold" Text="{loc:Loc Metric_Method}" />
                        <TextBlock Text="{Binding Method}" TextWrapping="Wrap" Margin="0,0,0,8"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                        <TextBlock FontWeight="SemiBold" Text="{loc:Loc Metric_Scale}" />
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                            <Run Text="{Binding Scale, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Direction, Mode=OneWay}" />
                        </TextBlock>

                        <TextBlock FontWeight="SemiBold" Text="{loc:Loc Metric_UsedIn}" />
                        <TextBlock Text="{Binding UsedIn}" TextWrapping="Wrap" Margin="0,0,0,8"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                        <TextBlock FontWeight="SemiBold" Text="{loc:Loc Metric_Caveats}" />
                        <TextBlock Text="{Binding Caveats}" TextWrapping="Wrap" Margin="0,0,0,8"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                        <WrapPanel>
                            <TextBlock Text="{loc:Loc Metric_Source}" FontWeight="SemiBold" Margin="0,0,6,0" />
                            <TextBlock Margin="0,0,16,0">
                                <Hyperlink NavigateUri="{Binding SourceUrl}" RequestNavigate="OnNavigate">
                                    <Run Text="{Binding Source, Mode=OneWay}" />
                                </Hyperlink>
                            </TextBlock>
                            <TextBlock Text="{loc:Loc Metric_Updated}" FontWeight="SemiBold" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding Updated}" />
                        </WrapPanel>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
