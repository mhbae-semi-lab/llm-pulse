<UserControl x:Class="LLMPulse.App.Views.CategoryDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:LLMPulse.App.Localization"
             xmlns:sp="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
             xmlns:app="clr-namespace:LLMPulse.App">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <app:InverseBoolToVisibilityConverter x:Key="InvBoolToVis" />
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,8,24,24">
            <DockPanel Margin="0,0,0,12">
                <Button DockPanel.Dock="Left" Content="{loc:Loc Action_Back}" Command="{Binding BackCommand}"
                        Padding="12,6" Margin="0,0,16,0" />
                <Button DockPanel.Dock="Right" Content="{loc:Loc Action_OpenLeaderboard}"
                        Command="{Binding OpenLeaderboardCommand}" Padding="12,6" />
                <TextBlock Text="{Binding Title}" FontSize="28" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>

            <TextBlock Text="{loc:Loc Dashboard_NoCategoryData}" Visibility="{Binding HasData, Converter={StaticResource InvBoolToVis}}"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

            <StackPanel Visibility="{Binding HasData, Converter={StaticResource BoolToVis}}">
                <Border Padding="20" Margin="0,0,0,16" CornerRadius="8"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock>
                            <Run Text="&#x1F3C6; " /><Run Text="{loc:Loc Card_Best}" FontWeight="SemiBold" />
                        </TextBlock>
                        <TextBlock Text="{Binding BestLine}" FontSize="20" />
                        <StackPanel Visibility="{Binding HasValueLine, Converter={StaticResource BoolToVis}}">
                            <TextBlock Margin="0,12,0,0">
                                <Run Text="&#x1F4B0; " /><Run Text="{loc:Loc Card_Value}" FontWeight="SemiBold" />
                            </TextBlock>
                            <TextBlock Text="{Binding ValueLine}" FontSize="20" />
                        </StackPanel>
                        <TextBlock Text="{Binding Rationale}" TextWrapping="Wrap" Margin="0,12,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{Binding GapNote}" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="#E5A02D">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <Trigger Property="Text" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{loc:Loc Chart_TopRanking}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <sp:WpfPlot x:Name="BarPlot" Height="420"
                                    AutomationProperties.Name="{loc:Loc Chart_TopRanking}" />
                        <TextBlock Text="{loc:Loc Chart_PlanLegend}" Margin="0,6,0,0"
                                   Visibility="{Binding ShowPlanLegend, Converter={StaticResource BoolToVis}}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" x:Name="ScatterPanel">
                        <TextBlock Text="{loc:Loc Chart_PriceVsScore}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <CheckBox x:Name="LogToggle" Content="{loc:Loc Chart_LogPrice}" IsChecked="True" Margin="0,0,0,6"
                                  Click="OnLogToggle" />
                        <sp:WpfPlot x:Name="ScatterPlot" Height="420"
                                    AutomationProperties.Name="{loc:Loc Chart_PriceVsScore}" />
                        <TextBlock x:Name="HoverText" Margin="0,6,0,0" MinHeight="24"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{loc:Loc Chart_ClickHint}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{loc:Loc Chart_ParetoHelp}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="{loc:Loc Chart_UsedMetrics}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8" />
                <!-- 가중치 조정 (지표가 여러 개인 분야) -->
                <StackPanel Visibility="{Binding CanTune, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8">
                    <TextBlock Text="{loc:Loc Weights_Help}" TextWrapping="Wrap" Margin="0,0,0,8"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ItemsControl ItemsSource="{Binding WeightRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="260" />
                                        <ColumnDefinition Width="300" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <Slider Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                                            Value="{Binding Percent, Mode=TwoWay, Delay=250}"
                                            AutomationProperties.Name="{Binding Name}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Share}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,12,0" />
                                    <Button Grid.Column="3" Content="&#x24D8;" Command="{Binding InfoCommand}"
                                            ToolTip="{loc:Loc Action_MetricInfo}" Padding="8,2"
                                            AutomationProperties.Name="{loc:Loc Action_MetricInfo}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="{loc:Loc Weights_Reset}" Command="{Binding ResetWeightsCommand}" Padding="12,6"
                                Visibility="{Binding IsCustomized, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Text="{loc:Loc Weights_Custom}" VerticalAlignment="Center" Margin="12,0,0,0"
                                   Visibility="{Binding IsCustomized, Converter={StaticResource BoolToVis}}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <!-- 이름 붙인 프리셋 -->
                    <WrapPanel Margin="0,12,0,0">
                        <TextBlock Text="{loc:Loc Preset_Label}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}" MinWidth="180"
                                  Visibility="{Binding HasPresets, Converter={StaticResource BoolToVis}}"
                                  AutomationProperties.Name="{loc:Loc Preset_Label}" />
                        <Button Content="{loc:Loc Preset_Delete}" Command="{Binding DeletePresetCommand}" Padding="10,4" Margin="8,0,0,0"
                                Visibility="{Binding HasPresets, Converter={StaticResource BoolToVis}}" />
                        <TextBox Text="{Binding NewPresetName, UpdateSourceTrigger=PropertyChanged}" Width="180" Margin="16,0,0,0"
                                 AutomationProperties.Name="{loc:Loc Preset_NewName}" />
                        <Button Content="{loc:Loc Preset_Save}" Command="{Binding SavePresetCommand}" Padding="10,4" Margin="8,0,0,0" />
                    </WrapPanel>
                </StackPanel>

                <ItemsControl ItemsSource="{Binding Metrics}"
                              Visibility="{Binding CanTune, Converter={StaticResource InvBoolToVis}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,0,0,6">
                                <Button DockPanel.Dock="Right" Content="&#x24D8;" Command="{Binding InfoCommand}"
                                        ToolTip="{loc:Loc Action_MetricInfo}" Padding="8,2"
                                        AutomationProperties.Name="{loc:Loc Action_MetricInfo}" />
                                <TextBlock>
                                    <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" />
                                    <Run Text=" · " /><Run Text="{loc:Loc Chart_Weight}" /><Run Text=" " /><Run Text="{Binding Weight, Mode=OneWay}" />
                                    <Run Text=" · " /><Run Text="{Binding Direction, Mode=OneWay}" />
                                </TextBlock>
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
