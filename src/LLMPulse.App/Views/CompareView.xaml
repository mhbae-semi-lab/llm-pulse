<UserControl x:Class="LLMPulse.App.Views.CompareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:LLMPulse.App.Localization"
             xmlns:sp="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
             xmlns:app="clr-namespace:LLMPulse.App">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <app:InverseBoolToVisibilityConverter x:Key="InvBoolToVis" />
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
        <StackPanel Margin="24,8,24,24">
            <DockPanel Margin="0,0,0,12">
                <Button DockPanel.Dock="Left" Content="{loc:Loc Action_Back}" Command="{Binding BackCommand}"
                        Padding="12,6" Margin="0,0,16,0" />
                <TextBlock Text="{Binding Title}" FontSize="28" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>

            <TextBlock Text="{loc:Loc Compare_Empty}" Visibility="{Binding HasModels, Converter={StaticResource InvBoolToVis}}"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

            <StackPanel Visibility="{Binding HasModels, Converter={StaticResource BoolToVis}}">
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{loc:Loc Compare_Radar}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <sp:WpfPlot x:Name="RadarPlot" Height="420" AutomationProperties.Name="{loc:Loc Compare_Radar}" />
                        <TextBlock Text="{loc:Loc Compare_RadarHelp}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <DockPanel Margin="0,0,0,8">
                            <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding TrendMetrics}"
                                      SelectedItem="{Binding SelectedTrendMetric}" MinWidth="180"
                                      AutomationProperties.Name="{loc:Loc Compare_TrendMetric}" />
                            <TextBlock Text="{loc:Loc Compare_Trend}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </DockPanel>
                        <sp:WpfPlot x:Name="TrendPlot" Height="420" AutomationProperties.Name="{loc:Loc Compare_Trend}" />
                        <TextBlock x:Name="TrendNote" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>

                <StackPanel x:Name="DomainPanel" Margin="0,0,0,16">
                    <TextBlock Text="{loc:Loc Compare_Domains}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <sp:WpfPlot x:Name="DomainPlot" Height="300" AutomationProperties.Name="{loc:Loc Compare_Domains}" />
                    <TextBlock Text="{loc:Loc Compare_DomainsHelp}" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="{loc:Loc Compare_TokensLabel}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox Text="{Binding MonthlyTokensText, UpdateSourceTrigger=LostFocus}" Width="90"
                             AutomationProperties.Name="{loc:Loc Compare_TokensLabel}" />
                    <TextBlock Text="{loc:Loc Compare_TokensUnit}" VerticalAlignment="Center" Margin="8,0,0,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <!-- 표: 모델 헤더 + 행 -->
                <ItemsControl ItemsSource="{Binding Models}" Margin="0,0,0,4">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Margin="220,0,0,0" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Width="200" FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                                <Run Text="{Binding Marker, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding Name, Mode=OneWay}" />
                            </TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,2">
                                <TextBlock Text="{Binding Label}" FontSize="18" FontWeight="SemiBold" Margin="0,14,0,4">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <StackPanel Orientation="Horizontal">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="{Binding Label}" Width="220" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <ItemsControl ItemsSource="{Binding Values}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate><TextBlock Text="{Binding}" Width="200" /></DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
